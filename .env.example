# Copy to .env beside docker-compose.yml. A missing or empty value means the default.

# Host port to publish Bookplate on. Default 3000.
PORT=3000

# Admin login. SET ADMIN_PASS BEFORE FIRST START: blank means the insecure
# default `changeme`.
ADMIN_USER=
ADMIN_PASS=

# Display name of the library. Empty uses the default.
LIBRARY_NAME=

# The public https origin clients use, no trailing slash. Empty disables
# features that need it (such as the MCP server).
PUBLIC_URL=

# Reverse-proxy hops to trust when reading the client IP. 1 for a single proxy.
TRUST_PROXY_HOPS=0

# Minimum validation score for uploaded books. Empty uses the default.
VALIDATION_THRESHOLD=

# Cloudflare account ID and API token for optional AI features. Empty disables.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Sender address and name for outgoing email. Empty uses the defaults.
EMAIL_FROM=
EMAIL_FROM_NAME=

# Log verbosity: debug, info, warn or error. Default info.
LOG_LEVEL=info
