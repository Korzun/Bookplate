# Copy to .env beside docker-compose.yml. A missing or empty value means the default.

# Host port to publish Bookplate on. Default 3000.
PORT=3000

# Admin login. SET ADMIN_PASS BEFORE FIRST START: blank means the insecure
# default `changeme`.
ADMIN_USER=
ADMIN_PASS=

# Display name of the library. Empty uses the default.
LIBRARY_NAME=

# The public https origin clients use, no trailing slash. Empty disables
# features that need it (such as the MCP server).
PUBLIC_URL=

# Reverse-proxy hops to trust when reading the client IP. 1 for a single proxy.
# The login lockout (5 failures / 15 min) and the e-reader sync lockouts key on
# that IP: too low a value behind a proxy or tunnel makes every client share one
# address, so a few bad attempts lock everyone out.
TRUST_PROXY_HOPS=0

# Minimum EPUBCheck severity that rejects an upload: Fatal, Error, Warning or Info.
# Empty uses the default (Error).
VALIDATION_THRESHOLD=

# Cloudflare Email Sending credentials (the token needs the Email Sending: Edit
# permission). They only take effect together with EMAIL_FROM; all three are required.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Sender address and name for outgoing email. Empty uses the defaults.
EMAIL_FROM=
EMAIL_FROM_NAME=

# Log verbosity: debug, info, warn or error. Default info.
LOG_LEVEL=info
