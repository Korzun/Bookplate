{
  "name": "bookplate-server",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "postinstall": "npm run prisma:generate || true",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/index.js",
    "dev": "NODE_ENV=development nodemon --watch . --ext ts,json --exec tsx index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cost": "vitest run graphql/cost-calibration graphql/client-operations-cost --reporter=verbose --retry=0",
    "lint": "oxlint && oxfmt --check \"**/*.ts\" && tsc --noEmit && tsc --noEmit -p tsconfig.test.json && npm run graphql:schema:check",
    "lint:fix": "oxlint --fix && oxfmt \"**/*.ts\"",
    "graphql:schema": "tsx graphql/print-schema.ts",
    "graphql:schema:check": "tsx graphql/print-schema.ts --check"
  },
  "dependencies": {
    "@korzun/epubcheck-ts": "^0.1.0-beta.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-prisma": "^4.15.0",
    "@pothos/plugin-relay": "^4.7.1",
    "@pothos/plugin-scope-auth": "^4.1.7",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "adm-zip": "^0.6.1",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.7.1",
    "fflate": "^0.8.3",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.1",
    "graphql-yoga": "^5.24.6",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^2.1.35",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "sharp": "^0.35.5",
    "smartcrop": "^2.0.5",
    "smartcrop-sharp": "^2.0.8",
    "web-push": "^3.6.7",
    "zod": "^4.6.6"
  },
  "optionalDependencies": {
    "@img/sharp-linux-arm64": "^0.34.5",
    "@img/sharp-linux-x64": "^0.34.5",
    "@img/sharp-linuxmusl-arm64": "^0.34.5",
    "@img/sharp-linuxmusl-x64": "^0.34.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.20",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.74.0",
    "prisma": "^7.10.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
