generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider = "prisma-pothos-types"
  output   = "../graphql/generated/pothos-types.ts"
}

datasource db {
  provider = "sqlite"
}

// mtime and addedAt store milliseconds since epoch; Float avoids Int's 32-bit validation limit
// while still round-tripping correctly through SQLite's INTEGER affinity.
model Book {
  userId          String          @map("user_id")
  id              String
  title           String
  titleSort       String          @default("") @map("title_sort")
  authorSort      String          @default("") @map("author_sort")
  publishDate     String          @default("") @map("publish_date")
  author          String          @default("")
  description     String          @default("")
  publisher       String          @default("")
  series          String          @default("")
  seriesIndex     Float           @default(0) @map("series_index")
  seriesId        String?         @map("series_id")
  identifiers     String          @default("[]")
  subjects        String          @default("[]")
  coverData       Bytes?          @map("cover_data")
  coverMime       String?         @map("cover_mime")
  size            Int
  mtime           Float
  addedAt         Float           @map("added_at")
  chapterCount    Int             @default(0) @map("chapter_count")
  chapterSpineMap String          @default("[]") @map("chapter_spine_map")
  chapterNames    String?         @map("chapter_names")
  pageCount       Int             @default(0) @map("page_count")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesRel       Series?         @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  thumbnails      BookThumbnail[]
  pendingFix      PendingFix?
  validation      Validation?
  // The reading position for this book, if the owner has one. See `Progress
  // .book` below for why this relation carries no database foreign key.
  progress        Progress?

  @@id([userId, id])
  @@map("books")
}

model Series {
  id         String @id
  userId     String @map("user_id")
  name       String
  sortKey    String @map("sort_key")
  subjects   String @default("[]")
  bookCount  Int    @default(0) @map("book_count")
  author     String @default("")
  publisher  String @default("")
  totalPages Int    @default(0) @map("total_pages")
  totalSize  Int    @default(0) @map("total_size")
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  books      Book[]

  @@unique([userId, name])
  @@map("series")
}

model PendingFix {
  userId    String @map("user_id")
  bookId    String @map("book_id")
  fileName  String @map("file_name")
  fileSize  Int    @map("file_size")
  state     String
  createdAt Float  @default(dbgenerated("strftime('%s','now') * 1000")) @map("created_at")
  updatedAt Float  @map("updated_at")

  book Book @relation(fields: [userId, bookId], references: [userId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, bookId])
  @@map("pending_fixes")
}

model Validation {
  userId      String @map("user_id")
  bookId      String @map("book_id")
  valid       Boolean
  threshold   String
  validatedAt Float  @map("validated_at")

  book     Book                @relation(fields: [userId, bookId], references: [userId, id], onDelete: Cascade, onUpdate: Cascade)
  messages ValidationMessage[]

  @@id([userId, bookId])
  @@map("validations")
}

model ValidationMessage {
  userId   String  @map("user_id")
  bookId   String  @map("book_id")
  seq      Int
  code     String
  severity String
  message  String
  path     String?
  line     Int?
  column   Int?    @map("column_num")

  validation Validation @relation(fields: [userId, bookId], references: [userId, bookId], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, bookId, seq])
  @@map("validation_messages")
}

model BookThumbnail {
  userId String @map("user_id")
  bookId String @map("book_id")
  width  Int
  data   Bytes
  mime   String
  book   Book   @relation(fields: [userId, bookId], references: [userId, id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, bookId, width])
  @@map("book_thumbnails")
}

model User {
  id                 String            @id
  username           String            @unique
  passwordHash       String?           @map("password_hash")
  syncPassword       String?           @map("sync_password")
  mustChangePassword Boolean           @default(false) @map("must_change_password")
  progresses         Progress[]
  progressHistories  ProgressHistory[]
  refreshTokens      RefreshToken[]
  books              Book[]
  series             Series[]
  deviceAccess       DeviceUser[]

  @@map("users")
}

model BookIdHistory {
  userId    String @map("user_id")
  oldId     String @map("old_id")
  currentId String @map("current_id")
  timestamp Float  @default(dbgenerated("strftime('%s', 'now') * 1000"))
  type      String @default("edit")

  @@id([userId, oldId])
  @@index([userId, currentId])
  @@map("book_id_history")
}

model Progress {
  userId     String @map("user_id")
  document   String
  progress   String
  percentage Float
  device     String
  deviceId   String @map("device_id")
  timestamp  Int
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // `document` IS the book's id — both hold the same KOReader content hash
  // (`routes/kosync.ts` writes `document` as `resolveBookId(...)`'s result).
  // `userId` is part of the relation deliberately: a content hash is the same
  // string for the same file on two users' shelves, so a join on `document`
  // alone would cross tenants. 1:1 rather than a list because `@@id([userId,
  // document])` makes the pair unique.
  //
  // NO DATABASE FOREIGN KEY IS EMITTED, and this relation therefore asserts a
  // referential integrity SQLite is not enforcing. That is deliberate and it
  // is also a trap:
  //  - Orphans are NORMAL on both sides and must keep resolving. A KOReader
  //    device syncs progress for whatever it is reading, imported here or not,
  //    so a `Progress` row routinely names a `document` with no `Book`
  //    (`book` -> null); a book nobody has opened has no progress
  //    (`progress` -> null). Both were probed against a real database.
  //  - Nothing generates DDL from this file. `prisma/migrations/*/migration.sql`
  //    is hand-written and applied by `db/migrate.ts`'s own runner, so adding
  //    this relation adds no constraint to any existing or new database.
  //  - `relationMode` is left at its default `"foreignKeys"`, which documents
  //    the OPPOSITE assumption. Running `prisma migrate dev` here would
  //    generate a migration adding a real FK, and that migration would FAIL
  //    against the orphan rows above. Do not run it; hand-write the SQL, as
  //    every migration in this repo already is.
  book       Book?  @relation(fields: [userId, document], references: [userId, id])

  @@id([userId, document])
  // EXISTS ONLY TO SHAPE `Library.progress`'s CURSOR, and is never used as a
  // lookup key by any query.
  //
  // `@pothos/plugin-prisma` derives a connection's cursor from the field or
  // index named in the `cursor:` option, and the cursor must carry every column
  // the page's `orderBy` sorts on — otherwise a resolver cannot reconstruct
  // "the rows after this one" without re-reading the cursor row itself, which
  // is exactly what breaks when that row is deleted mid-pagination. The primary
  // key `[userId, document]` does not carry `timestamp`; this index does.
  // `library/model.ts`'s `progress` resolver translates the parsed cursor into
  // a keyset `where` and never passes Prisma a `cursor` at all.
  //
  // It emits no DDL, for the same reason the relation above emits no foreign
  // key (see that comment), and unlike the relation that is harmless rather
  // than merely safe: these columns are a SUPERSET of the primary key, so the
  // uniqueness is already guaranteed by `@@id` and this constraint cannot be
  // violated even in principle. A physical index here would be a modest read
  // win for the page query's `ORDER BY`, and is deliberately NOT added: every
  // database rebuilds `progress` from scratch in `data_v10_user_surrogate_id`
  // (`db/migrate.ts`), which runs AFTER the DDL pass, so a `CREATE INDEX`
  // migration would be dropped on its way in and would have to be mirrored
  // inside that rebuild — the trap `prisma/migrations/
  // 20260801000000_book_id_history_current_id_index` already documents for
  // another table.
  @@unique([userId, timestamp, document])
  @@map("progress")
}

model RefreshToken {
  tokenHash String  @id @map("token_hash")
  userId    String? @map("user_id") // null for the config-based admin
  username  String
  expiresAt Float   @map("expires_at")
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([username])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model ProgressHistory {
  id             Int    @id @default(autoincrement())
  userId         String @map("user_id")
  document       String
  progress       String
  percentage     Float
  device         String
  deviceId       String @map("device_id")
  startTimestamp Int    @map("start_timestamp")
  endTimestamp   Int    @map("end_timestamp")
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document, progress, deviceId, endTimestamp])
  @@map("progress_history")
}

model Device {
  id           String       @id
  name         String
  slug         String       @unique
  coverWidth   Int?         @map("cover_width")
  coverHeight  Int?         @map("cover_height")
  coverFit     String       @default("contain") @map("cover_fit")
  bwCover      Boolean      @default(false) @map("bw_cover")
  simplify     Boolean      @default(false)
  createdAt    Float        @default(dbgenerated("strftime('%s', 'now') * 1000")) @map("created_at")
  updatedAt    Float        @default(dbgenerated("strftime('%s', 'now') * 1000")) @map("updated_at")
  enabledUsers DeviceUser[]

  @@map("devices")
}

model DeviceEdition {
  userId         String @map("user_id")
  originalBookId String @map("original_book_id")
  deviceId       String @map("device_id")
  editionId      String @map("edition_id")
  settingsHash   String @map("settings_hash")
  createdAt      Float  @default(dbgenerated("strftime('%s', 'now') * 1000")) @map("created_at")

  @@id([userId, originalBookId, deviceId])
  @@index([userId, editionId])
  @@map("device_editions")
}

model DeviceUser {
  deviceId  String @map("device_id")
  userId    String @map("user_id")
  createdAt Float  @default(dbgenerated("strftime('%s', 'now') * 1000")) @map("created_at")
  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([deviceId, userId])
  @@index([userId])
  @@map("device_users")
}
