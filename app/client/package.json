{
  "name": "bookplate-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "oxlint src && oxfmt --check \"src/**/*.{ts,tsx}\" --ignore-path .oxfmtignore && tsc --noEmit && npm run codegen:check",
    "lint:fix": "oxlint src --fix && oxfmt \"src/**/*.{ts,tsx}\" --ignore-path .oxfmtignore",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check"
  },
  "dependencies": {
    "@apollo/client": "^4.2.9",
    "classnames": "^2.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-jss": "^10.10.0",
    "react-router": "^8.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.0",
    "@graphql-codegen/fragment-matcher": "^7.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
